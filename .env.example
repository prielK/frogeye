POSTGRES_USER=frogeye
POSTGRES_PASSWORD=frogeye
POSTGRES_DB=frogeye
DATABASE_URL=postgresql+psycopg://frogeye:frogeye@db:5432/frogeye
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
COOKIE_SECURE=false
TIMEZONE=Asia/Jerusalem
HTTP_USER_AGENT=Mozilla/5.0 (compatible; FrogEye/0.1)
SEC_USER_AGENT=
GITHUB_TOKEN=
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=
SMTP_HOST=mailpit
SMTP_PORT=1025
DEMO_MODE=false
# auto: a brand-new, empty database starts from the bundled demo snapshot (backend/snapshot/);
# off: it starts empty. A database that already has tables is never touched.
DEMO_SNAPSHOT=auto
MODEL_FAST=gpt-5-nano
MODEL_SMART=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=512
LLM_DAILY_BUDGET_USD=0.75
LLM_TOTAL_BUDGET_USD=9
# Stage B leaves this much of the day's cap for the briefing.
NEWSROOM_RESERVE_USD=0.05
REASONING_EFFORT_FAST=minimal
REASONING_EFFORT_SMART=low
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
ANALYSIS_LOOKBACK_DAYS=14
TRIAGE_CAP=400
ANALYSIS_CAP=120
BRIEFING_MIN_IMPORTANCE=25
BRIEFING_MAX_SIGNALS=25
RAG_RERANK_DEFAULT=false
BRIEFING_FROM=FrogEye <briefing@frogeye.local>
# The address readers open FrogEye at; briefing emails and Slack posts link every story here.
APP_URL=http://localhost:8080
